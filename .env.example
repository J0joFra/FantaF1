# Copia questo file in ".env" e compila i valori.
# Le variabili devono iniziare con VITE_ per essere leggibili dal front-end Vite.

# URL del Web App di Google Apps Script che riceve le segnalazioni bug
# e le salva nel Google Sheet. Vedi docs/bug-report-google-sheet.md
VITE_BUG_REPORT_WEBHOOK_URL=

# (opzionale) Versione mostrata/allegata alle segnalazioni
VITE_APP_VERSION=

# Chiave PUBBLICA VAPID per le notifiche push web (promemoria gara).
# La privata NON va qui: si imposta come secret sulla Supabase Edge Function.
# Vedi docs/web-push-notifiche.md
VITE_VAPID_PUBLIC_KEY=
